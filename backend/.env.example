# Copy to backend/.env and fill in what you need. Every value has a working
# default, so the API starts with this file absent.

# ---- Paths -----------------------------------------------------------------
# Root for everything written at runtime: checkpoints, job logs, HF cache.
# REFLEX_DATA_DIR=./storage

# Override individual roots if you keep them on different volumes.
# STORAGE_PATH=/data/models
# CUBE_STORAGE_PATH=/data/cubes
# HF_HOME=/data/huggingface

# ---- Database --------------------------------------------------------------
# SQLite is fine locally. A hosted container's disk is wiped on restart, so any
# deployment needs a hosted Postgres — Neon and Supabase both have a permanent
# free tier. Paste their connection string as-is: the `postgres://` scheme and
# the missing sslmode are normalised for you.
# DATABASE_URL=postgresql://user:password@host/dbname

# ---- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. "*" is accepted but
# then credentialed requests are disabled, since browsers reject that pairing.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# LOG_LEVEL=INFO

# ---- Accounts ----------------------------------------------------------------
# REQUIRED in any deployment. At least 32 bytes; the server refuses a shorter
# one. Without it, a per-process secret is generated and everyone is signed out
# on every restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# How long a session lasts (default: 7 days).
# ACCESS_TOKEN_TTL_MINUTES=10080

# Require an account for training and cube execution. Leave on for anything
# reachable from the internet: both spend real CPU.
# REQUIRE_AUTH=1

# Close signups once you have the users you want.
# ALLOW_REGISTRATION=1
# MIN_PASSWORD_LENGTH=8

# Concurrent training jobs. A free container has two cores.
# MAX_CONCURRENT_JOBS_PER_USER=1
# MAX_CONCURRENT_JOBS_TOTAL=2

# ---- Model publishing ----------------------------------------------------------
# Push finished models to the Hugging Face Hub. Essential on a hosted container,
# whose disk is wiped on restart: without this a trained model exists only until
# the instance recycles. Needs HF_TOKEN below, or a per-user token set in the
# application's settings page.
# PUBLISH_MODELS_TO_HUB=0

# Account or organisation models are published under. Empty means the account
# that owns HF_TOKEN.
# HUB_NAMESPACE=

# Create the pushed repositories as private.
# HUB_PRIVATE=0

# ---- Training --------------------------------------------------------------
# Rows used per job. Hub corpora run to millions of examples and an uncapped
# CPU fine-tune never finishes; 0 disables the cap.
# MAX_TRAIN_SAMPLES=2000
# MAX_EVAL_SAMPLES=500
# TRAIN_EPOCHS=1
# TRAIN_BATCH_SIZE=8
# TRAIN_LEARNING_RATE=2e-5
# TRAIN_MAX_LENGTH=128

# Let `datasets` run loading scripts shipped by a Hub repo. That is arbitrary
# code execution; leave off unless you trust the dataset.
# HF_TRUST_REMOTE_CODE=0

# Largest base model a job may fine-tune, in parameters. Training needs roughly
# four times the model's size in RAM for gradients and optimizer state, so on a
# small box a large model is OOM-killed rather than finishing. Refusing up front
# gives the user a reason. 0 disables the check.
# MAX_MODEL_PARAMETERS=200000000

# Wall-clock budget for one run, in seconds. A job that reaches it stops and
# saves what it has rather than occupying the instance. 0 disables the limit.
# MAX_TRAIN_SECONDS=1800

# ---- Models ----------------------------------------------------------------
# BRAIN_MODEL_ID=google/gemma-2b-it
# EMBEDDING_MODEL_ID=all-MiniLM-L6-v2

# Load the agent model at startup instead of on first use. Off by default: it
# downloads several gigabytes before the server answers its first request.
# BRAIN_EAGER_LOAD=0

# ---- Credentials (all optional; the related features degrade without them) --
# Hugging Face token. A *write* token enables model publishing above and is
# needed for gated models such as Gemma.
# HF_TOKEN=

# E2B sandbox, used to execute agent-written Python.
# E2B_API_KEY=

# Apify, used by the scraping tools.
# APIFY_API_TOKEN=

# SerpApi, used for agent web search.
# SERPAPI_API_KEY=
