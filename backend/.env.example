# Copy to backend/.env and fill in what you need. Every value has a working
# default, so the API starts with this file absent.

# ---- Paths -----------------------------------------------------------------
# Root for everything written at runtime: checkpoints, job logs, HF cache.
# REFLEX_DATA_DIR=./storage

# Override individual roots if you keep them on different volumes.
# STORAGE_PATH=/data/models
# CUBE_STORAGE_PATH=/data/cubes
# HF_HOME=/data/huggingface

# ---- Database --------------------------------------------------------------
# DATABASE_URL=sqlite:///./reflex.db

# ---- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. "*" is accepted but
# then credentialed requests are disabled, since browsers reject that pairing.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# LOG_LEVEL=INFO

# ---- Training --------------------------------------------------------------
# Rows used per job. Hub corpora run to millions of examples and an uncapped
# CPU fine-tune never finishes; 0 disables the cap.
# MAX_TRAIN_SAMPLES=2000
# MAX_EVAL_SAMPLES=500
# TRAIN_EPOCHS=1
# TRAIN_BATCH_SIZE=8
# TRAIN_LEARNING_RATE=2e-5
# TRAIN_MAX_LENGTH=128

# Let `datasets` run loading scripts shipped by a Hub repo. That is arbitrary
# code execution; leave off unless you trust the dataset.
# HF_TRUST_REMOTE_CODE=0

# ---- Models ----------------------------------------------------------------
# BRAIN_MODEL_ID=google/gemma-2b-it
# EMBEDDING_MODEL_ID=all-MiniLM-L6-v2

# Load the agent model at startup instead of on first use. Off by default: it
# downloads several gigabytes before the server answers its first request.
# BRAIN_EAGER_LOAD=0

# ---- Credentials (all optional; the related features degrade without them) --
# Hugging Face token, needed for gated models such as Gemma.
# HF_TOKEN=

# E2B sandbox, used to execute agent-written Python.
# E2B_API_KEY=

# Apify, used by the scraping tools.
# APIFY_API_TOKEN=

# SerpApi, used for agent web search.
# SERPAPI_API_KEY=
