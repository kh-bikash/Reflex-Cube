# Base URL of the Reflex Cube API.
#
# Leave empty for local development: requests then go to the Vite dev server's
# own origin and are proxied to http://localhost:8000 (see vite.config.ts), which
# keeps everything same-origin so SSE and cookies work without CORS.
#
# Set it to an absolute URL when the API is on another host — a Vercel
# frontend against a Hugging Face Space, say. No trailing slash. It is baked
# into the bundle at build time, so changing it needs a redeploy.
#   VITE_API_URL=https://your-name-reflex-cube-api.hf.space
VITE_API_URL=

# Dev-server port (defaults to 8080).
# PORT=8080

# Where the dev server proxies /api to (defaults to http://localhost:8000).
# VITE_PROXY_TARGET=http://localhost:8000
