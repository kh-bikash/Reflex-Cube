# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
venv/
.venv/
env/
backend/venv/
backend/.venv/

# ---- Node ----
node_modules/
.npm/
# Vite writes these next to the config when it transpiles it
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ---- Builds ----
dist/
dist-ssr/
build/
*.local

# ---- Environment ----
.env
.env.*
!.env.example

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Databases ----
*.db
*.sqlite
*.sqlite3

# ---- Runtime artifacts ----
# Trained checkpoints, job logs and scratch output produced at runtime.
# `storage/` keeps a committed .gitkeep so the volume mount point exists.
storage/*
!storage/.gitkeep
backend/storage/*
!backend/storage/.gitkeep
*.safetensors
*.ckpt
*.pt
*.h5
*.onnx
*.tvim
nexus_db.json

# ---- Logs ----
*.log
logs/
